{
  "workdir": ".",
  "output_dir": "output",
  "cache_dir": ".cache/turkey-close-report",
  "target_date": "auto",
  "template_path": "templates/close_report_template.txt",
  "sources": {
    "bloomberght_closing": {
      "enabled": true,
      "use_project_fetcher": false
    }
  },
  "llm": {
    "provider": "minimax",
    "model": "MiniMax-M3",
    "api_key_env": "MINIMAX_API_KEY",
    "base_url": "https://api.minimaxi.com/v1",
    "temperature": 0.4,
    "max_tokens": 8000
  },
  "holidays": [
    "2027-03-09",
    "2027-03-10",
    "2027-03-11",
    "2027-05-17",
    "2027-05-18"
  ],
  "schedule": {
    "timezone": "Asia/Shanghai",
    "trading_days_only": true,
    "primary_bj": "00:10",
    "primary_window_bj": [
      "00:05",
      "00:15"
    ],
    "alternate_primary_bj": "23:55",
    "retry_bj": "00:15",
    "retry_once_on": [
      "list_absent",
      "bht_missing",
      "gen_failed"
    ],
    "skip_retry_if_output_exists": true,
    "notes": "CMS stamp ~23:30 BJ; /borsa related rail may appear ~23:50+. Prefer primary 00:05-00:15; or 23:55 + one retry at 00:15."
  },
  "brief": {
    "enabled": true,
    "template_path": "templates/close_report_brief_template.txt",
    "min_chars": 200,
    "max_chars": 600,
    "max_tokens": 2000,
    "temperature": 0.3
  }
}